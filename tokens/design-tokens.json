{
  "$description": "gui·olsen — design tokens (W3C Design Tokens format). 'color' and 'font.family' are the per-project layer: edit these for every new client, everything else is the fixed system scale.",
  "color": {
    "primary": { "$value": "#0F0F0F", "$type": "color", "$description": "Brand primary — headings, primary text, secondary button fill. Edit per project." },
    "primary-hover": { "$value": "#1A1A1A", "$type": "color", "$description": "Primary hover state. Edit per project." },
    "primary-tint": { "$value": "#F4F4F4", "$type": "color", "$description": "Light tint of primary — subtle backgrounds. Edit per project." },
    "secondary": { "$value": "#555555", "$type": "color", "$description": "Brand secondary — supporting/muted text. Edit per project." },
    "secondary-hover": { "$value": "#6E6E6E", "$type": "color", "$description": "Secondary hover state. Edit per project." },
    "secondary-tint": { "$value": "#E5E5E5", "$type": "color", "$description": "Light tint of secondary. Edit per project." },
    "accent": { "$value": "#0066FF", "$type": "color", "$description": "Brand accent — CTA, links, eyebrow labels. Edit per project." },
    "accent-hover": { "$value": "#0052CC", "$type": "color", "$description": "Accent hover state. Edit per project." },
    "accent-tint": { "$value": "#E6F0FF", "$type": "color", "$description": "Accent tint — badges, subtle highlighted backgrounds. Edit per project." },
    "white": { "$value": "#FFFFFF", "$type": "color", "$description": "Base neutral — rarely changes." },
    "black": { "$value": "#0F0F0F", "$type": "color", "$description": "Base neutral — rarely changes." }
  },
  "font": {
    "family": {
      "primary": { "$value": "Inter, -apple-system, BlinkMacSystemFont, sans-serif", "$type": "fontFamily", "$description": "Body/UI typeface. Edit per project." },
      "secondary": { "$value": "Syne, sans-serif", "$type": "fontFamily", "$description": "Heading typeface (display/h1/h2/h3). Edit per project." }
    },
    "size": {
      "display": { "$value": "64px", "$type": "dimension" },
      "h1": { "$value": "40px", "$type": "dimension" },
      "h2": { "$value": "28px", "$type": "dimension" },
      "h3": { "$value": "18px", "$type": "dimension" },
      "body-lg": { "$value": "18px", "$type": "dimension" },
      "body": { "$value": "16px", "$type": "dimension" },
      "body-sm": { "$value": "14px", "$type": "dimension" },
      "eyebrow": { "$value": "12px", "$type": "dimension" },
      "caption": { "$value": "12px", "$type": "dimension" },
      "button": { "$value": "14px", "$type": "dimension" }
    }
  },
  "space": {
    "4": { "$value": "4px", "$type": "dimension" },
    "8": { "$value": "8px", "$type": "dimension" },
    "12": { "$value": "12px", "$type": "dimension" },
    "16": { "$value": "16px", "$type": "dimension" },
    "24": { "$value": "24px", "$type": "dimension" },
    "32": { "$value": "32px", "$type": "dimension" },
    "48": { "$value": "48px", "$type": "dimension" },
    "64": { "$value": "64px", "$type": "dimension" },
    "96": { "$value": "96px", "$type": "dimension" },
    "128": { "$value": "128px", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0px", "$type": "dimension" },
    "sm": { "$value": "2px", "$type": "dimension" },
    "md": { "$value": "4px", "$type": "dimension" },
    "lg": { "$value": "8px", "$type": "dimension" },
    "rounded": { "$value": "999px", "$type": "dimension", "$description": "Full pill — opt-in, not used by default (brand default is sharp corners)" }
  }
}
